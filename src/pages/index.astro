---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Graham Moguche | Portfolio</title>
		
		<style>
			/* Entry Animation Baselines */
			.animate-on-load {
				opacity: 0;
				transform: translateY(15px);
				transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
				            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.animate-reveal {
				opacity: 1;
				transform: translateY(0);
			}

			/* Skeleton Loaders */
			.skeleton-card {
				height: 140px;
				background: linear-gradient(90deg, #161b22 25%, #21262d 50%, #161b22 75%);
				background-size: 200% 100%;
				animation: skeleton-loading 1.5s infinite;
				border-radius: 6px;
				border: 1px solid #30363d;
			}

			@keyframes skeleton-loading {
				0% { background-position: 200% 0; }
				100% { background-position: -200% 0; }
			}

			/* Custom Accent Metrics Layout */
			.project-metric {
				font-size: 0.85rem;
				color: #8b949e;
				margin-top: 0.75rem;
				padding-top: 0.75rem;
				border-top: 1px dashed #30363d;
			}
		</style>
	</head>
	<body>
		<main class="container">
			<!-- Header Profile -->
			<header class="animate-on-load" style="margin-bottom: 3rem;">
				<h1>Graham Moguche</h1>
				<p style="color: var(--accent-color); font-size: 1.25rem; margin: 0;">Software Engineer & Security Analyst</p>
			</header>

			<!-- Bio/Hero -->
			<section class="animate-on-load">
				<h2>About Me</h2>
				<p>I bridge the gap between robust software engineering, defensive cybersecurity, and data-driven insights. I build secure enterprise architectures, simulate defensive testing environments, and extract actionable data intelligence using Java, Python, and modern cloud ecosystems.</p>
			</section>

			<!-- Technologies -->
			<section class="animate-on-load">
				<h2>Technical Skills</h2>
				<div class="tag-container">
					<span class="tag">Java</span>
					<span class="tag">Python</span>
					<span class="tag">TypeScript</span>
					<span class="tag">NestJS</span>
					<span class="tag">Spring Boot</span>
					<span class="tag">PostgreSQL</span>
					<span class="tag">Redis</span>
					<span class="tag">Docker</span>
					<span class="tag">Defensive Cyber Engineering</span>
				</div>
			</section>

			<!-- 1. DETAILED CUSTOM CORE PROJECTS SHOWCASE -->
			<section class="animate-on-load">
				<h2>Core Engineered Solutions</h2>
				<p style="color: #8b949e; margin-bottom: 1.5rem;">Deep-dive implementations highlighting security architecture, test automation, and systems verification.</p>
				<div class="grid">
					
					<!-- Card 1: Cyber Security -->
					<div class="card">
						<h3 style="color: #ff7b72; margin-top: 0;">🛡️ Hybrid Network Defense Simulator</h3>
						<p>Built a comprehensive security simulation suite featuring a scriptable command terminal environment paired with a real-time defense monitoring control board. Simulates threat vectors and automated mitigation sequences.</p>
						<div class="tag-container">
							<span class="tag">Java</span>
							<span class="tag">JavaFX</span>
							<span class="tag">Automation Scripting</span>
							<span class="tag">Threat Modeling</span>
						</div>
						<div class="project-metric">
							📌 <strong>Key Implementations:</strong> Custom packet validation structures & live firewall control dashboards.
						</div>
					</div>

					<!-- Card 2: Backend Architecture -->
					<div class="card">
						<h3 style="color: #79c0ff; margin-top: 0;">⚡ NovaChat Backend & Live Session Router</h3>
						<p>Engineered a distributed, resilient chat infrastructure backend handling fast stream session routing, JSON Web Token (JWT) identity propagation, and proactive runtime logging utilities.</p>
						<div class="tag-container">
							<span class="tag">NestJS</span>
							<span class="tag">TypeScript</span>
							<span class="tag">PostgreSQL</span>
							<span class="tag">Redis Cache</span>
						</div>
						<div class="project-metric">
							📌 <strong>Key Implementations:</strong> Docker container setups & connection authentication interceptors.
						</div>
					</div>

					<!-- Card 3: Data Analytics & Verification -->
					<div class="card">
						<h3 style="color: #7ee787; margin-top: 0;">📈 Data Automation Suite & Verification Engine</h3>
						<p>Developed an end-to-end data pipelines suite capable of processing telemetry streams and executing automated logic verification using rigorous continuous integration parsing structures.</p>
						<div class="tag-container">
							<span class="tag">Python</span>
							<span class="tag">Pytest</span>
							<span class="tag">Data Wrangling</span>
							<span class="tag">Log Parsing</span>
						</div>
						<div class="project-metric">
							📌 <strong>Key Implementations:</strong> Continuous integration automated reporting modules & clean trend plotting wrappers.
						</div>
					</div>

				</div>
			</section>

			<!-- 2. DYNAMIC LIVE STREAM FROM GITHUB -->
			<section class="animate-on-load" style="margin-top: 4rem;">
				<h2>Active Source Streams</h2>
				<p style="color: #8b949e; margin-bottom: 1.5rem;">Real-time repositories pulled from my GitHub development logs via API hooks.</p>
				<div class="grid" id="github-repos-container">
					<!-- Animated Skeletons while fetching -->
					<div class="skeleton-card"></div>
					<div class="skeleton-card"></div>
					<div class="skeleton-card"></div>
				</div>
			</section>

			<!-- Contact Footer -->
			<footer class="animate-on-load" style="margin-top: 5rem; padding-top: 2rem; border-top: 1px solid #21262d; text-align: center;">
				<p>Let's build something secure.</p>
				<p>
					<a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a> &bull; 
					<a href="mailto:your-email@example.com">Email</a> &bull;
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</p>
			</footer>
		</main>

		<!-- Script Control Layer -->
		<script>
			// !! Put your exact Github Account Name here !!
			const GITHUB_USERNAME = 'GrahamMoguche'; 
			const container = document.getElementById('github-repos-container');

			async function fetchGitHubRepos() {
				try {
					const response = await fetch(`https://github.com{GITHUB_USERNAME}/repos?sort=updated&per_page=4`);
					if (!response.ok) throw new Error('API limit restricted');
					
					const repos = await response.json();
					if (container) container.innerHTML = ''; 

					// Strip out forks to keep focus clean
					const originalRepos = repos.filter((repo: any) => !repo.fork);

					if (originalRepos.length === 0) {
						if (container) container.innerHTML = '<p style="color: #8b949e;">Check out my pinned tabs directly on GitHub.</p>';
						return;
					}

					originalRepos.forEach((repo: any, index: number) => {
						const card = document.createElement('div');
						card.className = 'card animate-on-load';
						
						const description = repo.description || 'Secure software construction and system design documentation.';
						const languageTag = repo.language ? `<span class="tag">${repo.language}</span>` : '';
						const starsTag = repo.stargazers_count > 0 ? `<span class="tag">⭐ ${repo.stargazers_count}</span>` : '';

						card.innerHTML = `
							<h3><a href="${repo.html_url}" target="_blank" rel="noopener noreferrer">${repo.name}</a></h3>
							<p style="font-size: 0.95rem; color: #8b949e;">${description}</p>
							<div class="tag-container">
								${languageTag}
								${starsTag}
								<span class="tag" style="color: var(--accent-sec); border-color: rgba(35,134,54,0.4);">✓ Live Sync</span>
							</div>
						`;
						
						if (container) container.appendChild(card);

						setTimeout(() => {
							card.classList.add('animate-reveal');
						}, index * 100 + 100); 
					});
				} catch (error) {
					console.warn("API restricted. Streaming sub-parameters securely.");
					if (container) {
						container.innerHTML = `
							<p style="color: #8b949e; grid-column: 1 / -1; font-size: 0.9rem; font-style: italic;">
								Live stream sync paused. Explore source branches directly inside my official repository index above.
							</p>
						`;
					}
				}
			}

			// ENTRY ANIMATION COUPLER
			document.addEventListener('DOMContentLoaded', () => {
				const staticAnimatedElements = document.querySelectorAll('main > .animate-on-load');
				staticAnimatedElements.forEach((element, index) => {
					setTimeout(() => {
						element.classList.add('animate-reveal');
					}, index * 120);
				});

				fetchGitHubRepos();
			});
		</script>
	</body>
</html>
